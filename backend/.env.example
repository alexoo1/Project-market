# --- Application ---
PROJECT_NAME="Project Market"
ENVIRONMENT=development
DEBUG=true

# --- Base de données ---
# En local via docker-compose, l'hôte est "db" (nom du service)
DATABASE_URL=postgresql+psycopg2://project_market:project_market@db:5432/project_market
POSTGRES_USER=project_market
POSTGRES_PASSWORD=project_market
POSTGRES_DB=project_market

# --- Sécurité / JWT ---
# IMPORTANT: générer une vraie valeur aléatoire en production
# (ex: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- OTP SMS (désactivé pour le MVP) ---
OTP_ENABLED=false
OTP_CODE_LENGTH=6
OTP_EXPIRE_MINUTES=5

# --- CORS ---
CORS_ORIGINS=["*"]

# --- Stockage d'images ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/media
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media
# S3 / Cloudflare R2 (à renseigner plus tard)
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# --- Monétisation ---
# Payés uniquement par l'acheteur, aucun minimum, le vendeur reçoit 100% du prix fixé.
BUYER_PROTECTION_FEE_PERCENT=5.0

# --- Devise ---
CURRENCY_CODE=XOF
CURRENCY_LABEL=FCFA
